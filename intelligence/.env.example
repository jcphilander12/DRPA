# Server-only optional connections. Leave empty for the synthetic demonstration.
# Never use public client environment variables for credentials.
OPENAI_API_KEY=
AI_MODEL=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
# Base64-encoded random 32-byte encryption key; set through a secret manager.
XERO_TOKEN_ENCRYPTION_KEY=
# Optional override. Default is the read-only scope set below.
XERO_SCOPES=offline_access accounting.reports.profitandloss.read accounting.settings.read
